#!/usr/bin/env bash
set -euo pipefail
# Canonical customer release gate. Alpha26 is not accepted for distribution.
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
fail() { printf 'Notes customer release BLOCKED: %s\n' "$*" >&2; exit 1; }
[[ "$#" == 0 ]] || fail "No arguments accepted"
bash "$ROOT/tools/check"
VERSION="$(php -r '$p=file_get_contents($argv[1]); preg_match("/Version:\s*(\S+)/", $p, $m); echo $m[1] ?? "";' "$ROOT/core-blueprint-notes.php")"
[[ "$VERSION" == '0.1.0-alpha26' ]] ||
  fail "Release version requires a separate reviewed customer builder patch"
# The Alpha26 fixture uses tools/build-alpha26-fixture, and must never count as Level 3.
# Reviewed six-locale catalogs, real Level 2 acceptance and field evidence remain open.
fail "Alpha26 is an internal test candidate; missing required Level 2, locale and field approval"
