node "$ROOT/tests/library-interaction-smoke.cjs"
node "$ROOT/tests/library-markers-interaction.cjs"
node --check "$ROOT/assets/library-bulk.js"
node "$ROOT/tests/library-bulk-contract.cjs"
node "$ROOT/tests/library-overview-contract.cjs"
node "$ROOT/tests/library-table-contract.cjs"
node "$ROOT/tests/library-sidebar-contract.cjs"
node "$ROOT/tests/rc1-source-contract.cjs"
node "$ROOT/tests/rc1-js-i18n-contract.cjs"
node "$ROOT/tests/library-bulk-interaction.cjs"
node --check "$ROOT/assets/sharing.js"
node "$ROOT/tests/sharing-ui-contract.cjs"
